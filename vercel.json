{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/professor",
      "destination": "/index.html"
    },
    {
      "source": "/professor/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/aluno",
      "destination": "/index.html"
    },
    {
      "source": "/aluno/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|paineldoprofessor).*)",
      "destination": "/index.html"
    }
  ]
}
