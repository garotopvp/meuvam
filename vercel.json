{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/aluno(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/strava/sync-all",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/professor",
      "destination": "/professor/index.html"
    },
    {
      "source": "/professor/:path*",
      "destination": "/professor/index.html"
    },
    {
      "source": "/aluno",
      "destination": "/index.html"
    },
    {
      "source": "/aluno/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|professor|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
